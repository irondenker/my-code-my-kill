<main class="form-signin w-100 m-auto">
    <a href="/" class="d-flex align-items-center mb-2 mb-lg-0 link-body-emphasis text-decoration-none">
        <svg class="bi mb-4" role="img" alt="" width="72" height="57">
            <use href="/assets/vendor/bootstrap-5.3.8-examples/icons.svg#bootstrap"></use>
        </svg>
    </a>
    <form>
        <h1 class="h3 mb-3 fw-normal">로그인</h1>
        <div class="form-floating">
            <input type="username" class="form-control" id="floatingInput" placeholder="username" />
            <label for="floatingInput">Username</label>
        </div>
        <div class="form-floating">
            <input type="password" class="form-control" id="floatingPassword" placeholder="Password" />
            <label for="floatingPassword">Password</label>
        </div>
        <div class="form-check text-start my-3">
            <input class="form-check-input" type="checkbox" value="remember-me" id="checkDefault" />
            <label class="form-check-label" for="checkDefault">
                Username 기억
            </label>
        </div>
        <button class="btn btn-primary w-100 py-2" type="submit">
            로그인
        </button>
        <hr class="my-4" />
        <div>
            <p class="fs-6 mb-3">
                처음 방문이신가요?
                <a href="/register"> 회원가입</a>
            </p>
        </div>
        <p class="mt-5 mb-3 text-body-secondary">&copy; 2025. Irondenker™ All rights reserved.</p>
    </form>
</main>