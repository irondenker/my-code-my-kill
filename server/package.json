{
  "name": "server",
  "dependencies": {
    "csurf": "^1.11.0",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-session": "^1.18.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sharp": "^0.33.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/csurf": "^1.11.2",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.17.7",
    "@types/multer": "^1.4.13",
    "@types/node": "^25.0.3",
    "nodemon": "^3.1.11",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "nodemon",
    "dev:tsx": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "node scripts/run-tests.mjs unit",
    "test:db": "node scripts/run-tests.mjs db",
    "fix:openapi-drift": "node --import tsx src/scripts/sync-openapi-endpoints.ts",
    "check:openapi-drift": "node --import tsx src/scripts/check-openapi-drift.ts",
    "flowmap:gen": "node --import tsx src/scripts/generate-flowmap.ts",
    "flowmap:check": "node --import tsx src/scripts/check-flowmap-drift.ts",
    "assets:fetch": "node ../scripts/fetch_assets_post_images.js",
    "assets:avatars": "node ../scripts/gen_assets_avatars_webp.js",
    "assets:files": "node ../scripts/gen_assets_files.js",
    "seed": "sequelize-cli db:seed:all",
    "start": "node dist/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed:all": "sequelize-cli db:seed:all"
  },
  "type": "module"
}
