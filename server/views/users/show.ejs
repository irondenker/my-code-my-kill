<!doctype html>
<html lang="en" data-bs-theme="auto">
<%- include("../partials/head", {
    styles: [
        "/assets/vendor/bootstrap-5.3.8-examples/css/internal.css",
        "/assets/vendor/bootstrap-5.3.8-examples/css/list-groups.css"
    ]
}) %>

<body>
    <%- include("../partials/theme-toggle") %>
    <%- include("../partials/header") %>

    <main class="container py-4" style="max-width: 920px;">
        <div class="mb-3">
            <a href="/board" class="text-decoration-none">&larr; Back to board</a>
        </div>

        <section class="card shadow-sm">
            <div class="card-body">
                <h1 class="h4 mb-3">@<%= profile.username %></h1>
                <div class="mb-2"><strong>Display name</strong>: <%= profile.displayName || "-" %></div>
                <div class="mb-2"><strong>Bio</strong>: <%= profile.bio || "-" %></div>

                <% if (privateProfile) { %>
                <div class="mt-3 border-top pt-3">
                    <div class="mb-2"><strong>Email</strong>: <%= privateProfile.email || "-" %></div>
                    <div class="mb-2"><strong>Phone</strong>: <%= privateProfile.phoneNumber || "-" %></div>
                </div>
                <% } %>

                <% if (showAdminNotice) { %>
                <div class="alert alert-warning mt-3 mb-0" role="alert">
                    관리자 권한으로 사용자 비공개 정보 포함 조회 중
                </div>
                <% } %>
            </div>
        </section>

        <% if (showOwnerActions) { %>
        <div class="alert alert-info mt-3" role="alert">
            Account management is coming soon.
        </div>
        <% } %>
    </main>

    <%- include("../partials/footer") %>
    <%- include("../partials/scripts", {
        scripts: [
            "/assets/vendor/bootstrap-5.3.8-examples/js/color-modes.js"
        ]
    }) %>
</body>
</html>
