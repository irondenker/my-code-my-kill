<!doctype html>
<html lang="en" data-bs-theme="auto">
<%- include("../partials/head", { 
    styles: [ 
    "/assets/vendor/bootstrap-5.3.8-examples/css/internal.css",
    "/assets/vendor/bootstrap-5.3.8-examples/css/list-groups.css"
    ] 
}) %>

<body>
    <%- include("../partials/theme-toggle") %>
    <%- include("../partials/header") %>
    <main>
        <% 
            const user = {
                username: "umjunsik",
                email: "a@a.a",
                displayName: "엄준식",
                bio: "사람아니야124234123",
            };
        %>
        <div class="container flex-column flex-md-row p-4 gap-4 align-items-center justify-content-center">
            <h1 class="display-5 p-4 fw-bold text-body-emphasis">
                <a href="/board" class="text-decoration-none text-reset">
                    마이페이지
                </a>
            </h1>

            <div class="card mb-3 w-auto">
                <div class="card-body">
                    <div class="mb-2"><strong>아이디</strong> : <%= user.username %></div>
                    <div class="mb-2"><strong>이메일</strong> : <%= user.email %></div>
                    <div class="mb-2"><strong>표시 이름</strong> : <%= user.displayName %></div>
                    <div class="mb-2"><strong>소개</strong> : <%= user.bio %></div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a class="btn btn-outline-primary" href="/mypage/profile">프로필 수정</a>
                <a class="btn btn-outline-secondary" href="/mypage/password">비밀번호 변경</a>
                <a class="btn btn-outline-danger" href="/mypage/danger">계정 삭제</a>
            </div>

            <% if (typeof updated !=='undefined' ) { %>
            <div class="alert alert-success mt-3">저장 완료</div>
            <% } %>
        </div>
        <%- include("../partials/footer") %>
        <%- include("../partials/scripts", {
        scripts: [
         "/assets/vendor/bootstrap-5.3.8-examples/js/color-modes.js" 
        ] 
    }) %>
    </main>
</body>

</html>