<!doctype html>
<html lang="en">
    <%- include("../partials/head", {
        styles: [
            "/assets/css/color-modes.css"
        ]
    }) %>

    <body>
        <%- include("../partials/theme-toggle") %>
        <main class="container py-5" style="max-width: 720px;">
            <h1 class="h4 mb-3">Something went wrong</h1>
            <p class="text-muted">Status: <%= status %></p>
            <p><%= message %></p>
            <a class="btn btn-outline-secondary btn-sm mt-3" href="/">Go home</a>
            <% if (stack) { %>
            <pre class="mt-3 small"><%= stack %></pre>
            <% } %>
        </main>
        <%- include("../partials/footer") %>
        <%- include("../partials/scripts", {
            scripts: [
                "/assets/js/color-modes.js"
            ]
        }) %>
    </body>
</html>
