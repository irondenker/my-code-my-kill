<!doctype html>
<html lang="en" data-bs-theme="auto">
    <%- include("../partials/head", {
        styles: [
            "/assets/css/internal.css",
            "/assets/css/list-groups.css",
        ]
    }) %>

    <body>
        <%- include("../partials/theme-toggle") %>
        <%- include("../partials/header") %>

        <main class="container py-4" style="max-width: 920px;">
            <div class="mb-3">
                <a href="/board/<%= boardSlug %>/<%= displayId %>" class="text-decoration-none">&larr; Back to post</a>
            </div>

            <h1 class="h4 mb-3">Edit post - <%= boardDisplayName %></h1>

            <% if (formError) { %>
            <div class="alert alert-danger" role="alert"><%= formError %></div>
            <% } %>

            <form method="post" action="/board/<%= boardSlug %>/<%= displayId %>/edit" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input
                        type="text"
                        class="form-control"
                        id="title"
                        name="title"
                        maxlength="255"
                        required
                        value="<%= typeof title === 'string' ? title : '' %>"
                    />
                </div>
                <div class="mb-3">
                    <label for="content" class="form-label">Content</label>
                    <textarea
                        class="form-control"
                        id="content"
                        name="content"
                        rows="10"
                        required
                    ><%= typeof content === 'string' ? content : '' %></textarea>
                </div>
                <% if (imageUrl) { %>
                <div class="mb-3">
                    <div class="text-muted small mb-2">Current image</div>
                    <img src="<%= imageUrl %>" alt="Current image" class="img-fluid rounded border" />
                    <div class="mt-2">
                        <% const imageLabel = (typeof imageName === "undefined" || !imageName) ? "Open image" : imageName; %>
                        <a href="<%= imageUrl %>" class="text-decoration-none small" target="_blank" rel="noreferrer">
                            <%= imageLabel %>
                        </a>
                    </div>
                </div>
                <% } %>
                <% if (fileUrl) { %>
                <div class="mb-3">
                    <div class="text-muted small mb-2">Current attachment</div>
                    <a href="<%= fileUrl %>" class="text-decoration-none" download>
                        <%= fileName || "Download attachment" %>
                    </a>
                </div>
                <% } %>
                <div class="mb-3">
                    <label for="image" class="form-label">Replace image (optional)</label>
                    <input
                        type="file"
                        class="form-control"
                        id="image"
                        name="image"
                        accept="image/jpeg,image/png,image/webp"
                    />
                    <div class="form-text">Max 20MB and 5120px. JPG/PNG/WebP only.</div>
                </div>
                <div class="mb-3">
                    <label for="attachment" class="form-label">Replace attachment (optional)</label>
                    <input
                        type="file"
                        class="form-control"
                        id="attachment"
                        name="attachment"
                        accept=".pdf,.txt,.csv,.zip"
                    />
                    <div class="form-text">Max 10MB. PDF/TXT/CSV/ZIP only.</div>
                </div>
                <button class="btn btn-primary" type="submit">Save</button>
            </form>
        </main>

        <%- include("../partials/footer") %>
        <%- include("../partials/scripts", {
            scripts: [
                "/assets/js/color-modes.js"
            ]
        }) %>
    </body>
</html>
