<!doctype html>
<html lang="en" data-bs-theme="auto">
  <%- include("../../partials/head", { styles: [ "/assets/css/color-modes.css" ] }) %>

  <body>
    <%- include("../../partials/theme-toggle") %>
    <%- include("../../partials/header") %>

    <main class="container py-4" style="max-width: 1080px">
      <% const safeAdminCount = typeof adminCount === "number" ? adminCount : 0; %>

      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h1 class="h4 mb-1">User Management</h1>
          <p class="text-muted mb-0">Manage account lifecycle and admin permissions.</p>
        </div>
        <div class="d-flex gap-2">
          <a class="btn btn-outline-primary" href="/admin/audit-logs">View audit logs</a>
          <a class="btn btn-outline-secondary" href="/admin">Back to dashboard</a>
        </div>
      </div>

      <% if (formError) { %>
      <div class="alert alert-danger" role="alert"><%= formError %></div>
      <% } %>
      <% if (formSuccess) { %>
      <div class="alert alert-success" role="alert"><%= formSuccess %></div>
      <% } %>

      <div class="card">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-striped mb-0 align-middle">
              <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">Username</th>
                  <th scope="col">Role</th>
                  <th scope="col">Status</th>
                  <th scope="col">Created</th>
                  <th scope="col" class="text-end">Action</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach((user) => { %>
                <% const isSelf = Number(sessionUser) === user.userId; %>
                <% const disableDeactivate = user.userRole === "admin" && user.isActive; %>
                <% const disableRoleChange = user.userRole === "admin" && (safeAdminCount <= 1 || isSelf); %>
                <% const roleBadgeClass = user.userRole === "admin" ? "text-bg-dark" : "text-bg-secondary"; %>
                <% const activeBadgeClass = user.isActive ? "text-bg-success" : "text-bg-danger"; %>
                <% const activeLabel = user.isActive ? "active" : "inactive"; %>
                <% const nextStatus = user.isActive ? "inactive" : "active"; %>
                <% const statusButtonClass = user.isActive ? "btn-outline-danger" : "btn-outline-success"; %>
                <% const statusButtonLabel = user.isActive ? "Deactivate" : "Activate"; %>
                <% const nextRole = user.userRole === "admin" ? "user" : "admin"; %>
                <% const roleButtonClass = user.userRole === "admin" ? "btn-outline-warning" : "btn-outline-primary"; %>
                <% const roleButtonLabel = user.userRole === "admin" ? "Revoke admin" : "Make admin"; %>
                <tr>
                  <td><%= user.userId %></td>
                  <td>
                    <code><%= user.username %></code>
                  </td>
                  <td>
                    <span class="badge <%= roleBadgeClass %>"> <%= user.userRole %> </span>
                  </td>
                  <td>
                    <span class="badge <%= activeBadgeClass %>"> <%= activeLabel %> </span>
                  </td>
                  <td>
                    <%= new Date(user.createdAt).toISOString().slice(0, 10) %>
                  </td>
                  <td class="text-end">
                    <form
                      method="post"
                      action="/admin/users/<%= user.userId %>/status"
                      class="d-inline"
                    >
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <input type="hidden" name="status" value="<%= nextStatus %>" />
                      <% if (disableDeactivate) { %>
                      <button
                        class="btn btn-sm <%= statusButtonClass %>"
                        type="submit"
                        disabled
                        title="Admin users cannot be deactivated."
                      >
                        <%= statusButtonLabel %>
                      </button>
                      <% } else { %>
                      <button class="btn btn-sm <%= statusButtonClass %>" type="submit">
                        <%= statusButtonLabel %>
                      </button>
                      <% } %>
                    </form>
                    <form
                      method="post"
                      action="/admin/users/<%= user.userId %>/role"
                      class="d-inline ms-1"
                    >
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <input type="hidden" name="role" value="<%= nextRole %>" />
                      <% if (disableRoleChange) { %>
                      <button class="btn btn-sm <%= roleButtonClass %>" type="submit" disabled>
                        <%= roleButtonLabel %>
                      </button>
                      <% } else { %>
                      <button class="btn btn-sm <%= roleButtonClass %>" type="submit">
                        <%= roleButtonLabel %>
                      </button>
                      <% } %>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>

    <%- include("../../partials/footer") %>
    <%- include("../../partials/scripts", {
            scripts: [
                "/assets/js/color-modes.js"
            ]
        }) %>
  </body>
</html>
