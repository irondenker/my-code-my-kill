<!doctype html>
<html lang="en" data-bs-theme="auto">
    <%- include("../partials/head", {
        styles: [
            "/assets/css/color-modes.css"
        ]
    }) %>

    <body>
        <%- include("../partials/theme-toggle") %>
        <%- include("../partials/header") %>

        <main class="container py-4" style="max-width: 980px;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-1">Admin Dashboard</h1>
                    <p class="text-muted mb-0">Manage boards and monitor basic service stats.</p>
                </div>
                <a class="btn btn-outline-secondary" href="/board">Go to board</a>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <p class="text-muted small mb-1">Users</p>
                            <p class="h4 mb-0"><%= stats.users %></p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <p class="text-muted small mb-1">Active posts</p>
                            <p class="h4 mb-0"><%= stats.posts %></p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <p class="text-muted small mb-1">Boards</p>
                            <p class="h4 mb-0"><%= stats.boards %></p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h2 class="h5">Quick actions</h2>
                    <div class="d-flex gap-2 mt-3">
                        <a class="btn btn-outline-primary" href="/admin/users">Manage users</a>
                        <a class="btn btn-primary" href="/admin/boards">Manage boards</a>
                    </div>
                </div>
            </div>
        </main>

        <%- include("../partials/footer") %>
        <%- include("../partials/scripts", {
            scripts: [
                "/assets/js/color-modes.js"
            ]
        }) %>
    </body>
</html>
