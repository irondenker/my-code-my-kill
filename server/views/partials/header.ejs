<header class="sticky-top p-3 border-bottom">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
            <a href="/" class="d-flex me-4 align-items-center mb-2 mb-lg-0 link-body-emphasis text-decoration-none">
                <svg class="bi me-2" width="40" height="40" role="img" aria-label="Logo">
                    <use xlink:href="/assets/icons/logo.svg#logo"></use>
                </svg>
                <h1 class="bi mb-1 align-middle fs-4">My Code, My Kill.</h1>
            </a>
            <ul class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">
                <li>
                    <a href="#" class="nav-link px-2 link-body-emphasis">Intro</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link px-2 link-body-emphasis dropdown-toggle" href="/board" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Board
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="/board/general">General</a></li>
                        <li><a class="dropdown-item" href="/board/announcement">Announcement</a></li>
                        <li><a class="dropdown-item" href="/board/useronly">User Only</a></li>
                        <li><a class="dropdown-item" href="/board/qna">Q&A</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link px-2 link-body-emphasis dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Labs
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="/labs/ssti">SSTI Lab</a></li>
                    </ul>
                </li>
                <li>
                    <a href="/api-docs" class="nav-link px-2 link-body-emphasis">API Docs</a>
                </li>
            </ul>

            <form class="col-12 col-lg-auto mb-3 mb-lg-0 me-lg-3" role="search">
                <input type="search" class="form-control" placeholder="Search..." aria-label="Search" disabled/>
            </form>

            <div class="d-flex align-items-center gap-2">
                <div class="dropdown text-end">
                    <% const headerAvatarUrl = sessionProfileImageUrl; %>
                    <a href="#" class="d-block link-body-emphasis text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <% if (headerAvatarUrl) { %>
                        <img src="<%= headerAvatarUrl %>" alt="Profile" width="32" height="32" class="rounded-circle" style="object-fit: cover;" />
                        <% } else { %>
                        <svg class="rounded-circle" width="32" height="32" aria-hidden="true">
                            <use xlink:href="/assets/icons/icons.svg#people-circle"></use>
                        </svg>
                        <% } %>
                    </a>
                    <ul class="dropdown-menu text-small">
                        <% if (sessionUser) { %>
                        <li><span class="dropdown-item-text">Signed in as <strong><%= sessionUsername || 'user' %></strong></span></li>
                        <% if (sessionUsername) { %>
                        <li><a class="dropdown-item" href="/@<%= sessionUsername %>">My Page</a></li>
                        <% } %>
                        <li>
                            <hr class="dropdown-divider" />
                        </li>
                        <li>
                            <form method="post" action="/logout" class="px-3 py-1">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-link dropdown-item p-0">Logout</button>
                            </form>
                        </li>
                        <% } else { %>
                        <li><a class="dropdown-item" href="/login">Login</a></li>
                        <% } %>
                    </ul>
                </div>
                <% if (sessionUserRole === "admin") { %>
                <a href="/admin" class="btn btn-sm btn-outline-danger">Admin</a>
                <% } %>
            </div>
        </div>
    </div>
</header>