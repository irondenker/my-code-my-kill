<%
    const _clientSideSanitizeEnabled =
        typeof clientSideSanitizeEnabled !== "undefined"
            ? Boolean(clientSideSanitizeEnabled)
            : true;
    const _xssClientSideOptions =
        typeof xssClientSideOptions !== "undefined" && xssClientSideOptions
            ? xssClientSideOptions
            : {};
    const _scripts = Array.isArray(typeof scripts !== "undefined" ? scripts : null) ? scripts : [];
    const _bootstrapConfigJson = JSON.stringify({
        clientSideSanitizeEnabled: _clientSideSanitizeEnabled,
        xssClientSideOptions: _xssClientSideOptions,
    }).replace(/</g, "\\u003c");
%>
<script id="app-bootstrap-config" type="application/json"><%- _bootstrapConfigJson %></script>
<script src="/assets/js/bootstrap-config.js" defer></script>
<% _scripts.forEach(function (src) { %>
    <script src="<%= src %>" defer></script>
<% }) %>

<script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js" defer></script>
<script src="/assets/js/app.js" defer></script>
