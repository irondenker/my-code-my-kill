<!-- Page Scripts -->
<script>
    window.__XSS_CLIENT_SIDE_SANITIZE_ENABLED__ = <%= clientSideSanitizeEnabled ? "true" : "false" %>;
    window.__XSS_CLIENT_SIDE_OPTIONS__ = <%- JSON.stringify(xssClientSideOptions).replace(/</g, "\\u003c") %>;
</script>
<% const _scripts = typeof scripts !== "undefined" ? scripts : []; %>
<% _scripts.forEach(function (src) { %>
    <script src="<%= src %>" defer></script>
<% }) %>

<script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js" defer></script>
<script src="/assets/js/app.js" defer></script>
