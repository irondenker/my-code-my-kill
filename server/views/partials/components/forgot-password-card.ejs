<main class="form-signin w-100 m-auto">
    <a href="/" class="d-flex align-items-center mb-2 mb-lg-0 link-body-emphasis text-decoration-none">
        <svg class="bi mb-3" width="72" height="72" aria-hidden="true" aria-label="Logo" role="img">
            <use xlink:href="/assets/icons/logo.svg#logo"></use>
        </svg>
    </a>
    <form method="post" action="/forgot-password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h1 class="h3 mb-3 fw-normal"><a class="auth-title-link" href="/forgot-password">Password reset</a></h1>
        <% if (formError) { %>
        <div class="alert alert-danger py-2" role="alert"><%= formError %></div>
        <% } %>
        <% if (formMessage) { %>
        <div class="alert alert-info py-2" role="alert"><%= formMessage %></div>
        <% } %>
        <% if (resetPasswordLink) { %>
        <div class="alert alert-warning py-2" role="alert">
            <div class="fw-semibold mb-1">Reset password link</div>
            <a class="fw-semibold" href="<%= resetPasswordLink %>">비밀번호 재설정</a>
        </div>
        <% } %>
        <div class="form-floating mb-3">
            <input type="text" class="form-control" id="forgotUsername" name="username" placeholder="username" value="<%= formData.username %>" required />
            <label for="forgotUsername">Username</label>
        </div>
        <button class="btn btn-primary w-100 py-2" type="submit">
            Request password reset
        </button>
        <hr class="my-4" />
        <p class="fs-6 mb-3">
            Back to
            <a class="fw-semibold" href="/login">Sign in</a>
        </p>
        <p class="mt-5 mb-3 text-body-secondary auth-copyright">&copy; 2025-2026. Irondenker&trade; All rights reserved.</p>
    </form>
</main>
