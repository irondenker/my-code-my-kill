<main class="form-signin w-100 m-auto">
    <a href="/" class="d-flex align-items-center mb-2 mb-lg-0 link-body-emphasis text-decoration-none">
        <svg class="bi mb-3" width="72" height="72" aria-hidden="true" aria-label="Logo" role="img">
            <use xlink:href="/assets/icons/logo.svg#logo"></use>
        </svg>
    </a>
    <form method="post" action="/forgot-password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h1 class="h3 mb-3 fw-normal">Password reset</h1>
        <% if (formError) { %>
        <div class="alert alert-danger py-2" role="alert"><%= formError %></div>
        <% } %>
        <% if (formMessage) { %>
        <div class="alert alert-info py-2" role="alert"><%= formMessage %></div>
        <% } %>
        <% if (devResetLink || devResetToken) { %>
        <div class="alert alert-warning py-2" role="alert">
            <div class="fw-semibold mb-1">Dev/Lab token reveal</div>
            <% if (devResetLink) { %>
            <div class="small mb-1">
                Reset link:
                <a href="<%= devResetLink %>"><%= devResetLink %></a>
            </div>
            <% } %>
            <% if (devResetToken) { %>
            <div class="small">Token: <code><%= devResetToken %></code></div>
            <% } %>
        </div>
        <% } %>
        <div class="form-floating">
            <input type="text" class="form-control" id="forgotUsername" name="username" placeholder="username" value="<%= formData.username %>" required />
            <label for="forgotUsername">Username</label>
        </div>
        <div class="form-floating">
            <input type="email" class="form-control" id="forgotEmail" name="email" placeholder="email" value="<%= formData.email %>" />
            <label for="forgotEmail">Email (optional)</label>
        </div>
        <div class="form-floating">
            <input type="text" class="form-control" id="forgotPhone" name="phoneNumber" placeholder="phoneNumber" value="<%= formData.phoneNumber %>" />
            <label for="forgotPhone">Phone (optional)</label>
        </div>
        <button class="btn btn-primary w-100 py-2" type="submit">
            Request password reset
        </button>
        <hr class="my-4" />
        <p class="fs-6 mb-2">
            Already have a token?
            <a href="/reset-password">Reset password</a>
        </p>
        <p class="fs-6 mb-3">
            Back to
            <a href="/login">Sign in</a>
        </p>
        <p class="mt-5 mb-3 text-body-secondary">&copy; 2025-2026. Irondenker&trade; All rights reserved.</p>
    </form>
</main>
