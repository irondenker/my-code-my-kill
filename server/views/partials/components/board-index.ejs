<main class="container py-4 board-page">
    <div class="board-layout">
        <%
            const boardTitle = typeof boardDisplayName === "string" ? boardDisplayName : "Board";
            const boardDesc = typeof boardDescription === "string" ? boardDescription : null;
            const boardHref = boardSlug ? `/board/${boardSlug}` : "/board";
            const isBoardDirectory = !boardSlug;
        %>
        <h1 class="display-5 py-2 fw-bold text-body-emphasis">
            <a href="<%= boardHref %>" class="text-decoration-none text-reset">
                <%= boardTitle %>
            </a>
        </h1>
        <% if (boardDesc) { %>
        <p class="text-muted mb-2"><%= boardDesc %></p>
        <% } %>
        <% if (canCreate && boardSlug) { %>
        <div class="pb-3">
            <a class="btn btn-primary" href="/board/<%= boardSlug %>/new">New post</a>
        </div>
        <% } %>
        <% if (isBoardDirectory) { %>
        <div class="list-group board-list">
            <% if (Array.isArray(boards) && boards.length > 0) { %>
            <% boards.forEach((board) => { %>
            <a href="/board/<%= board.slug %>" class="list-group-item list-group-item-action d-flex gap-3 p-3" aria-current="true">
                <svg class="bi flex-shrink-0" alt="" width="32" height="32">
                    <use xlink:href="/assets/icons/icons.svg#plain-post"></use>
                </svg>
                <div class="d-flex flex-column">
                    <h6 class="mb-0"><%= board.name %></h6>
                    <small class="text-muted">/<%= board.slug %></small>
                    <% if (board.description) { %>
                    <small class="text-muted"><%= board.description %></small>
                    <% } %>
                </div>
            </a>
            <% }) %>
            <% } else { %>
            <div class="list-group-item p-3 text-muted">No boards available.</div>
            <% } %>
        </div>
        <% } else { %>
        <div class="list-group board-list">
            <% postOutlines.forEach(post=> { %>
            <div>
                <a href="/board/<%= post.boardSlug %>/<%= post.displayId %>" class="list-group-item list-group-item-action d-flex gap-3 p-3" aria-current="true">
                    <svg class="bi flex-shrink-0" alt="" width="32" height="32">
                        <use xlink:href="/assets/icons/icons.svg#plain-post"></use>
                    </svg>
                    <div class="d-flex gap-2 flex justify-content-between">
                        <div>
                            <h6 class="mb-0">
                                <span class="text-muted me-2">#<%= post.displayId %></span>
                                <%= post.title %>
                            </h6>
                            <p class="mb-0 opacity-75">
                                <%= post.author %>
                            </p>
                        </div>
                        <%
                            const createdAt = post.createdAt;
                            const year = createdAt.getFullYear();
                            const month = String(createdAt.getMonth() + 1).padStart(2, "0");
                            const day = String(createdAt.getDate()).padStart(2, "0");
                            const hours = String(createdAt.getHours()).padStart(2, "0");
                            const minutes = String(createdAt.getMinutes()).padStart(2, "0");
                            const createdLabel = `${year}-${month}-${day} ${hours}:${minutes}`;
                        %>
                        <small class="opacity-50 text-nowrap"><%= createdLabel %></small>
                    </div>
                </a>
            </div>
            <% }) %>
        </div>
        <div class="d-flex justify-content-between my-2 board-pagination">

            <%
                const currentPage = pagination.page;
                const totalPages = pagination.totalPages;

                const pageRange = 1; // ±1
                const startPage = Math.max(1, currentPage - pageRange);
                const endPage = Math.min(totalPages, currentPage + pageRange);
            %>

            <div class="" id="dataTable_info" role="status" aria-live="polite">
                Showing <%= (currentPage - 1) * 10 + 1 %>
                to <%= (currentPage - 1) * 10 + postOutlines.length %>
                of <%= pagination.totalCount %> Posts
            </div>

            <div id="dataTable_paginate">
                <ul class="pagination">

                    <!-- Previous -->
                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                        <a class="page-link" href="?page=<%= currentPage - 1 %>">Previous</a>
                    </li>

                    <!-- 현재 페이지 기준 ±1 -->
                    <% for (let i = startPage; i <= endPage; i++) { %>
                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                    </li>
                    <% } %>

                    <!-- 생략 + 마지막 페이지 -->
                    <% if (endPage < totalPages) { %>
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>

                    <li class="page-item <%= currentPage === totalPages ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= totalPages %>"><%= totalPages %></a>
                    </li>
                    <% } %>

                    <!-- Next -->
                    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                        <a class="page-link" href="?page=<%= currentPage + 1 %>">Next</a>
                    </li>
                </ul>
            </div>
        </div>
        <% } %>
    </div>
</main>
