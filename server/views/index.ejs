<!DOCTYPE html>
<html lang="ko" data-bs-theme="auto">
    <%- include("partials/head", {
        styles: [
            "/assets/css/color-modes.css",
            "/assets/css/headers.css"
        ]
    }) %>
    <body>
        <%- include("partials/theme-toggle") %>
        <%- include("partials/header") %>
        <main class="landing-cover" aria-label="Landing Cover">
            <section class="landing-content text-center">
                <a href="/" class="d-inline-block text-reset text-decoration-none" aria-label="Go to home">
                    <svg class="landing-logo" role="img" aria-label="My Code My Kill Logo">
                        <use xlink:href="/assets/icons/logo.svg#logo"></use>
                    </svg>
                </a>
                <h1 class="landing-title">My Code, My Kill.</h1>
                <p class="landing-description">
                    이 페이지를 마주하신 여러분 모두를 환영합니다.<br>
                    Happy Hacking!
                </p>
            </section>
        </main>
        <%- include("partials/footer") %>
        <%- include("partials/scripts", {
            scripts: [
                "/assets/js/color-modes.js"
            ]
        }) %>
    </body>
</html>
