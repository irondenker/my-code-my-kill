{
  "debug": {
    "errorRoutes": {
      "enabled": false
    }
  },
  "sqlInjection": {
    "enabled": false,
    "targets": {
      "authLookup": false,
      "authCreate": false,
      "profileLookup": false,
      "profileUpdate": false,
      "boardLookup": false,
      "boardCreate": false,
      "boardUpdate": false,
      "articleLookup": false,
      "articleCreate": false,
      "articleUpdate": false,
      "articleDelete": false
    }
  },
  "ssti": {
    "enabled": false
  },
  "csrf": {
    "enabled": false
  },
  "uploadValidation": {
    "extensionCheck": true,
    "mimeCheck": true,
    "magicNumberCheck": true
  },
  "xss": {
    "stored": {
      "enabled": false
    },
    "sanitize": {
      "clientSide": {
        "enabled": true,
        "defaultRuleToggles": {
          "ampersand": true,
          "lessThan": true,
          "greaterThan": true,
          "doubleQuote": true,
          "singleQuote": true,
          "backtick": true
        },
        "customRules": [
          {
            "from": "&",
            "to": "&amp;"
          }
        ]
      },
      "serverSide": {
        "enabled": true,
        "defaultRuleToggles": {
          "ampersand": true,
          "lessThan": true,
          "greaterThan": true,
          "doubleQuote": true,
          "singleQuote": true,
          "backtick": true
        },
        "customRules": [
          {
            "from": "<",
            "to": "&lt;"
          },
          {
            "from": ">",
            "to": "&gt;"
          }
        ]
      }
    }
  },
  "securityDefense": {
    "enabled": false,
    "accountLockout": {
      "enabled": false,
      "maxFailures": 5,
      "lockMinutes": 10,
      "useLoginLockUntil": true
    },
    "passwordReset": {
      "enabled": false,
      "tokenTtlMinutes": 20,
      "devRevealToken": {
        "enabled": false
      },
      "pseudoVerify": {
        "enabled": false
      }
    },
    "rateLimit": {
      "enabled": false,
      "login": {
        "enabled": false,
        "maxRequests": 10,
        "windowSeconds": 60
      },
      "postsMutation": {
        "enabled": false,
        "maxRequests": 20,
        "windowSeconds": 60
      }
    },
    "simpleCaptcha": {
      "enabled": false,
      "login": {
        "enabled": false,
        "afterFailures": 3
      }
    }
  }
}
