{
  "debug": {
    "errorRoutes": {
      "enabled": false
    }
  },
  "sqlInjection": {
    "enabled": false,
    "targets": {
      "authLookup": false,
      "authCreate": false,
      "profileLookup": false,
      "profileUpdate": false,
      "boardLookup": false,
      "boardCreate": false,
      "boardUpdate": false,
      "articleLookup": false,
      "articleCreate": false,
      "articleUpdate": false,
      "articleDelete": false
    }
  },
  "ssti": {
    "enabled": false
  },
  "csrf": {
    "enabled": false
  },
  "uploadValidation": {
    "extensionCheck": {
      "enabled": true
    },
    "magicNumberCheck": {
      "enabled": true
    }
  },
  "xss": {
    "stored": {
      "enabled": false
    },
    "sanitize": {
      "clientSide": {
        "enabled": true,
        "defaultRuleToggles": {
          "ampersand": true,
          "lessThan": true,
          "greaterThan": true,
          "doubleQuote": true,
          "singleQuote": true,
          "backtick": true
        },
        "customRules": [
          {
            "from": "&",
            "to": "&amp;"
          }
        ]
      },
      "serverSide": {
        "enabled": true,
        "defaultRuleToggles": {
          "ampersand": true,
          "lessThan": true,
          "greaterThan": true,
          "doubleQuote": true,
          "singleQuote": true,
          "backtick": true
        },
        "customRules": [
          {
            "from": "<",
            "to": "&lt;"
          },
          {
            "from": ">",
            "to": "&gt;"
          }
        ]
      }
    }
  }
}
